# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# 运行时数据（SQLite 自动生成）
data/*.db
data/*.db-journal
data/backups/

# LLM 配置（含 API Key，绝不提交）
data/llm_config.json

# 对照导入的原始 PDF（原格式保留，随文档生命周期管理）
data/imports/

# 导出 / 渲染临时产物
output/

# v1 归档（不参与运行）
legacy/

# CFF OTF 会被 Chromium 降级为 Type3，fonts/ 只允许 glyf TTF
fonts/*.otf

# 用户上传的自有字体（运行时注册）
fonts/user/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
